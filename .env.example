# ==============================================================================
# JurisNG - Environment Configuration Template
# Duplicate this file as .env and fill in your actual credentials.
# ==============================================================================

# Resend Transactional Email API Key (obtain from resend.com)
RESEND_API_KEY=re_your_api_key_here

# Recipient Email for Bug Reports & Feedback
FEEDBACK_RECIPIENT_EMAIL=your-inbox@yourdomain.com

# Verified Sending Email (configured with DKIM/SPF on your subdomain)
RESEND_FROM_EMAIL=JurisNG Feedback <notifications@mail.yourdomain.com>

# Google Gemini API Key (Optional: for natural language scenario analysis)
GEMINI_API_KEY=
