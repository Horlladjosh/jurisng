    <style>
        .news-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1.5px solid rgba(44, 46, 129, 0.3);
            background: rgba(44, 46, 129, 0.06);
            color: #2c2e81;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
            z-index: 5;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }
        .news-arrow:hover {
            background: #2c2e81;
            border-color: #2c2e81;
            color: #fff;
        }
        .news-arrow:active {
            transform: translateY(-50%) scale(0.95);
        }
        .news-arrow-prev { left: 12px; }
        .news-arrow-next { right: 12px; }
        .news-slide { cursor: pointer; }
    </style>

    
    <script>
        (function () {
            try {
                var s = JSON.parse(localStorage.getItem("ndic-a11y") || "{}"),
                    c = document.documentElement.classList,
                    k = {
                        grayscale: ["negative-contrast"],
                        "high-contrast": ["negative-contrast", "light-bg"],
                        "negative-contrast": ["grayscale", "high-contrast", "light-bg"],
                        "light-bg": ["high-contrast", "negative-contrast"],
                    };
                [
                    "grayscale",
                    "high-contrast",
                    "negative-contrast",
                    "light-bg",
                    "underline-links",
                    "readable-font",
                ].forEach(function (f) {
                    if (!s[f]) return;
                    if ((k[f] || []).some(function (x) { return c.contains("a11y-" + x); })) return;
                    c.add("a11y-" + f);
                });
                if (s.textSize && s.textSize !== 16)
                    document.documentElement.style.fontSize = s.textSize + "px";
            } catch (e) {}
        })();
    </script>

    
